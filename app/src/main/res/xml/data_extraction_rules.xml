<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o posterior: la sesión (token JWT) no sale del teléfono ni en respaldos ni al transferir datos -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
